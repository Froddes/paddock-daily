---
import { formatDate, getAssetUrl } from '../lib/directus.js';

const { column, featured = false } = Astro.props;
const initial = column.author?.name?.charAt(0) || 'P';
const avatarUrl = getAssetUrl(column.author?.avatar, { width: 60, height: 60 });
---

<article class={`opinion-card${featured ? ' featured' : ''}`}>
  <span class="eyebrow-cat">OPINIÓN{column.category ? ` · ${column.category.name.toUpperCase()}` : ''}</span>
  <h3><a href={`/opinion/${column.slug}`}>{column.title}</a></h3>
  <p>{column.dek}</p>
  <div class="byline">
    <span class="avatar">{avatarUrl ? <img src={avatarUrl} alt={column.author?.name} /> : initial}</span>
    <div><strong>{column.author?.name}</strong><span class="meta">{formatDate(column.published_date)}</span></div>
  </div>
</article>
