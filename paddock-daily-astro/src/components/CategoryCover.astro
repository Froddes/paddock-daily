---
// Banner de cabecera por categoría — fotografía editorial (IA) por
// disciplina, con un motivo genérico de reserva para categorías nuevas
// que todavía no tengan imagen propia en public/covers/.
import { getCategoryCoverUrl } from '../lib/categoryImages.js';

const { slug = '', name = '' } = Astro.props;
---

<div class="category-cover">
  <img src={getCategoryCoverUrl(slug)} alt="" aria-hidden="true" />
</div>
