---
// Banner de cabecera por categoría — placeholder gráfico con un motivo
// distinto para cada disciplina (bandera de cuadros para F1, óvalo de
// pista para NASCAR, etc.), en vez del patrón abstracto genérico de
// ThumbPlaceholder. Sustituir por fotografía editorial real en Fase 5
// (con los derechos de imagen resueltos primero).
const { slug = '', name = '' } = Astro.props;

const key = slug.toLowerCase().replace(/[^a-z0-9]/g, '');
const w = 1200;
const h = 340;
---

<div class="category-cover">
  <svg viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMidYMid slice">
    <rect width={w} height={h} fill="#101010" />

    {/* F1 — bandera de cuadros en banda diagonal */}
    {key === 'f1' && (
      <g opacity="0.9">
        {Array.from({ length: 8 }).map((_, row) =>
          Array.from({ length: 22 }).map((_, col) => (
            (row + col) % 2 === 0 && (
              <rect
                x={-100 + col * 34}
                y={row * 30}
                width="34"
                height="30"
                fill="#2c2c2c"
                transform={`skewX(-18)`}
              />
            )
          ))
        )}
        <path d={`M0 ${h * 0.82} L${w} ${h * 0.62}`} stroke="#FF5A1F" stroke-width="3" opacity="0.85" />
      </g>
    )}

    {/* MotoGP — rueda inclinada tomando una curva */}
    {key === 'motogp' && (
      <g transform={`translate(${w * 0.18},${h * 0.55}) rotate(-22)`} opacity="0.9">
        <circle r="120" fill="none" stroke="#3a3a3a" stroke-width="10" />
        <circle r="120" fill="none" stroke="#FF5A1F" stroke-width="3" stroke-dasharray="18 14" opacity="0.8" />
        <circle r="14" fill="#2c2c2c" />
      </g>
    )}

    {/* WEC — resistencia, luces largas de exposición nocturna */}
    {(key === 'wec') && (
      <g stroke-width="2" fill="none" opacity="0.85">
        <path d={`M-40 ${h * 0.3} C ${w * 0.3} ${h * 0.1}, ${w * 0.5} ${h * 0.5}, ${w * 1.05} ${h * 0.2}`} stroke="#FF5A1F" />
        <path d={`M-40 ${h * 0.55} C ${w * 0.35} ${h * 0.4}, ${w * 0.55} ${h * 0.75}, ${w * 1.05} ${h * 0.5}`} stroke="#4a4a4a" />
        <path d={`M-40 ${h * 0.78} C ${w * 0.3} ${h * 0.65}, ${w * 0.6} ${h * 0.95}, ${w * 1.05} ${h * 0.75}`} stroke="#2c2c2c" />
      </g>
    )}

    {/* DTM — chevrones angulares agresivos */}
    {key === 'dtm' && (
      <g fill="none" stroke-width="10" opacity="0.85">
        <path d={`M0 ${h} L${w * 0.35} ${h * 0.15} L${w * 0.55} ${h}`} stroke="#2c2c2c" />
        <path d={`M${w * 0.3} ${h} L${w * 0.62} ${h * 0.15} L${w * 0.85} ${h}`} stroke="#FF5A1F" opacity="0.9" />
      </g>
    )}

    {/* IMSA — similar a resistencia, con doble haz de faros */}
    {key === 'imsa' && (
      <g opacity="0.85">
        <ellipse cx={w * 0.22} cy={h * 0.5} rx="10" ry="6" fill="#FF5A1F" />
        <path d={`M${w * 0.22} ${h * 0.47} L${w * 1.1} ${h * 0.1}`} stroke="#FF5A1F" stroke-width="2" opacity="0.7" />
        <ellipse cx={w * 0.22} cy={h * 0.62} rx="10" ry="6" fill="#8a8a8a" />
        <path d={`M${w * 0.22} ${h * 0.65} L${w * 1.1} ${h * 0.85}`} stroke="#8a8a8a" stroke-width="2" opacity="0.6" />
      </g>
    )}

    {/* NASCAR — óvalo de pista con peralte */}
    {key === 'nascar' && (
      <g opacity="0.9">
        <ellipse cx={w * 0.5} cy={h * 0.55} rx={w * 0.42} ry={h * 0.32} fill="none" stroke="#3a3a3a" stroke-width="8" />
        <ellipse cx={w * 0.5} cy={h * 0.55} rx={w * 0.3} ry={h * 0.2} fill="none" stroke="#2c2c2c" stroke-width="4" />
        <circle cx={w * 0.5 + w * 0.42} cy={h * 0.55} r="9" fill="#FF5A1F" />
      </g>
    )}

    {/* GT World Challenge (u otro no listado explícitamente) — silueta
        aerodinámica simple tipo GT */}
    {(key === 'gtworldchallenge' || key === 'gtwc') && (
      <g opacity="0.9">
        <path
          d={`M-20 ${h * 0.68} C ${w * 0.15} ${h * 0.6}, ${w * 0.28} ${h * 0.42}, ${w * 0.42} ${h * 0.42} L ${w * 0.66} ${h * 0.42} C ${w * 0.8} ${h * 0.42}, ${w * 0.92} ${h * 0.58}, ${w * 1.05} ${h * 0.66}`}
          fill="none" stroke="#3a3a3a" stroke-width="6"
        />
        <path d={`M${w * 0.3} ${h * 0.68} L${w * 0.85} ${h * 0.68}`} stroke="#FF5A1F" stroke-width="4" opacity="0.85" />
      </g>
    )}

    {/* Fallback genérico para categorías sin motivo propio todavía */}
    {!['f1','motogp','wec','dtm','imsa','nascar','gtworldchallenge','gtwc'].includes(key) && (
      <path d={`M-20 ${h * 0.78} C ${w * 0.3} ${h * 0.5}, ${w * 0.45} ${h}, ${w * 0.68} ${h * 0.7} S ${w * 1.05} ${h * 0.45}, ${w * 1.1} ${h * 0.6}`} stroke="#FF5A1F" stroke-width="2" fill="none" opacity="0.75" />
    )}

    {/* Overlay para que el título/texto encima siga siendo legible sea
        cual sea el motivo de fondo */}
    <defs>
      <linearGradient id="cat-cover-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#101010" stop-opacity="0.35" />
        <stop offset="55%" stop-color="#101010" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#101010" stop-opacity="0.94" />
      </linearGradient>
    </defs>
    <rect width={w} height={h} fill="url(#cat-cover-fade)" />
  </svg>
</div>
