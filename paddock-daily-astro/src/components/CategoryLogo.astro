---
// Logo oficial de cada categoría (F1, WEC, IMSA, DTM, GT World Challenge...).
// Busca en build time un archivo public/brand/categories/<slug>.(svg|png|webp)
// — el mismo esquema de normalización de slug que usa CategoryCover.astro —
// y si todavía no se ha subido el logo de esa categoría, cae de vuelta al
// monograma genérico (checker-accent) para no romper el layout.
//
// Casi todos estos logos están recoloreados en blanco (pensados para el
// hero oscuro de categoría/portada). Sobre fondo claro (tarjetas,
// cabecera de artículo, páginas de resultados) hay que pasar
// `onLight={true}`, que busca primero <slug>-onlight.(svg|png|webp) — la
// versión con los colores originales — y solo cae al archivo en blanco si
// esa variante no existe todavía.
//
// Cómo añadir un logo: guarda el archivo oficial (a ser posible SVG o PNG
// con fondo transparente) en public/brand/categories/ con el nombre de la
// categoría en minúsculas y sin espacios/símbolos, p. ej.:
//   f1.svg · wec.svg · gtworldchallenge.svg (o gtwc.svg) · imsa.svg ·
//   dtm.svg · indycar.svg · wrc.svg · nascar.svg · motogp.svg · gt.svg
// Y, si hace falta una versión para fondo claro, el mismo nombre con
// sufijo -onlight, p. ej. wec-onlight.svg.
import fs from 'node:fs';
import path from 'node:path';

const { slug = '', name = '', size = 20, onLight = false, class: className = '' } = Astro.props;

const key = slug.toLowerCase().replace(/[^a-z0-9]/g, '');
const dir = path.resolve('public/brand/categories');
const exts = ['svg', 'png', 'webp'];

let file = null;
if (key) {
  const candidates = onLight
    ? [key + '-onlight', key]
    : [key];
  outer: for (const base of candidates) {
    for (const ext of exts) {
      const candidate = `${base}.${ext}`;
      if (fs.existsSync(path.join(dir, candidate))) {
        file = candidate;
        break outer;
      }
    }
  }
}
---

{file ? (
  <img
    class={`cat-logo ${className}`}
    src={`/brand/categories/${file}`}
    alt={name ? `${name} logo` : ''}
    style={`height:${size}px`}
    loading="lazy"
  />
) : (
  <span class={`checker-accent ${className}`} aria-hidden="true"><span></span><span></span><span></span><span></span></span>
)}
