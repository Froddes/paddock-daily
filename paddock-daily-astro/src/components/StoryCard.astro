---
import ThumbPlaceholder from './ThumbPlaceholder.astro';
import { timeAgo, getAssetUrl } from '../lib/directus.js';

const { article, wide = false, eyebrow } = Astro.props;
const imageUrl = getAssetUrl(article.featured_image, { width: wide ? 900 : 500, height: wide ? 560 : 340 });
---

<article class={`story-card${wide ? ' wide' : ''}`}>
  <a class="thumb" href={`/articulo/${article.slug}`} aria-label={article.title}>
    {imageUrl ? (
      <img class="thumb-img" src={imageUrl} alt={article.title} loading="lazy" />
    ) : (
      <ThumbPlaceholder seed={article.slug} />
    )}
  </a>
  <div>
    <span class="eyebrow-cat">{eyebrow || article.category?.name}</span>
    <h3><a href={`/articulo/${article.slug}`}>{article.title}</a></h3>
    <p>{article.dek}</p>
    <span class="meta">{timeAgo(article.published_date)}</span>
  </div>
</article>
