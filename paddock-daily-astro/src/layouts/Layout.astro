---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';

const {
  title,
  description = 'Una pasión. Todas las categorías. Todo el paddock.',
  theme = 'light',
  headerVariant = 'full',
  footerVariant = 'simple',
  currentNav = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title ? `Paddock Daily — ${title}` : 'Paddock Daily'}</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;1,500;1,600&display=swap" rel="stylesheet" />
</head>
<body>
  <Header variant={headerVariant} currentNav={currentNav} />
  <main>
    <slot />
  </main>
  <Footer variant={footerVariant} />
</body>
</html>
