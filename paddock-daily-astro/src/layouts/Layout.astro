---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';

const {
  title,
  description = 'Una pasión. Todas las categorías. Todo el paddock.',
  theme = 'light',
  headerVariant = 'full',
  footerVariant = 'simple',
  currentNav = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title ? `Paddock Daily — ${title}` : 'Paddock Daily'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700;800&family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body>
  <Header variant={headerVariant} currentNav={currentNav} />
  <main>
    <slot />
  </main>
  <Footer variant={footerVariant} />
</body>
</html>
