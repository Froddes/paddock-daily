---
import Layout from '../layouts/Layout.astro';
import { getArticles, getOpinionColumns } from '../lib/directus.js';

// Búsqueda con MiniSearch: en vez del índice partido en muchos archivos de
// Pagefind (que Hostinger cortaba con 429 por exceso de peticiones), aquí
// se manda UN solo JSON con todo el contenido y toda la búsqueda pasa a
// ocurrir en el navegador, sin más peticiones de red.
//
// Si algún día esto pesa demasiado (varios miles de artículos), tocará
// paginar el índice o volver a un buscador partido en el servidor — ver
// la hoja de ruta del proyecto.

const CATEGORY_ALIASES = {
  'Fórmula 1': 'f1 formula1',
  MotoGP: 'motogp moto gp',
  'GT World Challenge': 'gtwc gt world',
};

const [articles, columns] = await Promise.all([
  getArticles({ limit: 1000 }),
  getOpinionColumns({ limit: 1000 }),
]);

const searchItems = [
  ...articles.map((a, i) => ({
    id: `a${i}`,
    title: a.title,
    category: a.category?.name || '',
    dek: a.dek || '',
    aliases: CATEGORY_ALIASES[a.category?.name] || '',
    href: `/articulo/${a.slug}`,
  })),
  ...columns.map((c, i) => ({
    id: `c${i}`,
    title: c.title,
    category: c.category ? `Opinión · ${c.category.name}` : 'Opinión',
    dek: c.dek || '',
    aliases: CATEGORY_ALIASES[c.category?.name] || '',
    href: `/opinion/${c.slug}`,
  })),
];
---

<Layout title="Buscar" headerVariant="full" footerVariant="simple">
  <section class="search-hero">
    <div class="wrap">
      <span class="eyebrow-cat">BUSCADOR</span>
      <h1>¿Qué estás buscando?</h1>
      <form class="search-form" role="search" onsubmit="return false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" placeholder="Piloto, equipo, circuito, categoría…" aria-label="Buscar en Paddock Daily" data-search-input autofocus />
      </form>
      <div class="search-meta-row">
        <span class="meta" data-search-count></span>
      </div>
    </div>
  </section>

  <section class="search-results">
    <div class="wrap">
      <div data-search-results></div>
    </div>
  </section>
</Layout>

<script type="application/json" id="search-data" set:html={JSON.stringify(searchItems)} />

<script>
  import MiniSearch from 'minisearch';

  function renderEmpty(container) {
    container.innerHTML = `
      <div class="search-empty">
        <strong>Busca por titular, piloto o categoría</strong>
        <p>Por ejemplo: "Verstappen", "MotoGP" o "constructores".</p>
      </div>`;
  }

  function renderNoResults(container, query) {
    container.innerHTML = `
      <div class="search-empty">
        <strong>Sin resultados para "${query}"</strong>
        <p>Prueba con otro término, o revisa la ortografía.</p>
      </div>`;
  }

  function renderResults(container, items) {
    container.innerHTML = items
      .map(
        (item) => `
        <article class="search-result">
          <a class="thumb" href="${item.href}" aria-label="${item.title}"><svg viewBox="0 0 300 190"><rect width="300" height="190" fill="#101010"/><path d="M0 40 L300 10" stroke="#3a3a3a" stroke-width="1.5"/></svg></a>
          <div>
            <span class="eyebrow-cat">${(item.category || 'PADDOCK DAILY').toUpperCase()}</span>
            <h3><a href="${item.href}">${item.title}</a></h3>
            <p>${item.dek || ''}</p>
          </div>
        </article>`
      )
      .join('');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const input = document.querySelector('[data-search-input]');
    const resultsEl = document.querySelector('[data-search-results]');
    const countEl = document.querySelector('[data-search-count]');
    const dataEl = document.getElementById('search-data');
    if (!input || !resultsEl || !dataEl) return;

    const items = JSON.parse(dataEl.textContent);

    const index = new MiniSearch({
      idField: 'id',
      fields: ['title', 'category', 'dek', 'aliases'],
      storeFields: ['title', 'category', 'dek', 'href'],
      searchOptions: {
        boost: { title: 3, category: 2, aliases: 2 },
        fuzzy: 0.2,
        prefix: true,
      },
    });
    index.addAll(items);

    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') || '';

    function update() {
      const query = input.value;
      if (!query.trim()) {
        renderEmpty(resultsEl);
        countEl.textContent = '';
        return;
      }

      const results = index.search(query);

      if (results.length === 0) {
        renderNoResults(resultsEl, query);
        countEl.textContent = `0 resultados para "${query}"`;
        return;
      }

      renderResults(resultsEl, results);
      countEl.textContent = `${results.length} resultado${results.length === 1 ? '' : 's'} para "${query}"`;
    }

    input.addEventListener('input', update);
    update();
  });
</script>
