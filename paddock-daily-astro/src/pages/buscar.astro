---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Buscar" headerVariant="full" footerVariant="simple">
  <section class="search-hero" data-pagefind-ignore>
    <div class="wrap">
      <span class="eyebrow-cat">BUSCADOR</span>
      <h1>¿Qué estás buscando?</h1>
      <form class="search-form" role="search" onsubmit="return false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" placeholder="Piloto, equipo, circuito, categoría…" aria-label="Buscar en Paddock Daily" data-search-input autofocus />
      </form>
      <div class="search-meta-row">
        <span class="meta" data-search-count></span>
      </div>
    </div>
  </section>

  <section class="search-results" data-pagefind-ignore>
    <div class="wrap">
      <div data-search-results></div>
    </div>
  </section>
</Layout>

<script>
  // Búsqueda con Pagefind: indexa en build time el HTML ya generado
  // (ver `data-pagefind-body`/`data-pagefind-meta` en Layout.astro y en las
  // plantillas de artículo/opinión), así que aquí solo consultamos su API.
  //
  // Importante: el índice (/pagefind/pagefind.js) solo existe DESPUÉS de un
  // `npm run build` (que ahora corre `pagefind --site dist`). En `npm run
  // dev` esa ruta no existe y la búsqueda no puede funcionar — probarla
  // siempre sobre el sitio ya desplegado.

  function normalizeCategory(raw) {
    return (raw || '').toString().trim();
  }

  function renderEmpty(container, query) {
    container.innerHTML = `
      <div class="search-empty">
        <strong>Busca por titular, piloto o categoría</strong>
        <p>Por ejemplo: "Verstappen", "MotoGP" o "constructores".</p>
      </div>`;
  }

  function renderNoResults(container, query) {
    container.innerHTML = `
      <div class="search-empty">
        <strong>Sin resultados para "${query}"</strong>
        <p>Prueba con otro término, o revisa la ortografía.</p>
      </div>`;
  }

  function renderUnavailable(container) {
    container.innerHTML = `
      <div class="search-empty">
        <strong>Buscador no disponible</strong>
        <p>El índice de búsqueda solo se genera al publicar el sitio — esto no funciona en <code>npm run dev</code>, solo en paddock-daily.com.</p>
      </div>`;
  }

  function renderResults(container, items) {
    container.innerHTML = items
      .map(
        (item) => `
        <article class="search-result">
          <a class="thumb" href="${item.href}" aria-label="${item.title}"><svg viewBox="0 0 300 190"><rect width="300" height="190" fill="#101010"/><path d="M0 40 L300 10" stroke="#3a3a3a" stroke-width="1.5"/></svg></a>
          <div>
            <span class="eyebrow-cat">${item.category.toUpperCase()}</span>
            <h3><a href="${item.href}">${item.title}</a></h3>
            <p>${item.excerpt}</p>
          </div>
        </article>`
      )
      .join('');
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const input = document.querySelector('[data-search-input]');
    const resultsEl = document.querySelector('[data-search-results]');
    const countEl = document.querySelector('[data-search-count]');
    if (!input || !resultsEl) return;

    let pagefind;
    try {
      pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
    } catch (err) {
      // Normal en local (npm run dev): el índice aún no existe.
      input.addEventListener('input', () => {
        if (input.value.trim()) renderUnavailable(resultsEl);
        else renderEmpty(resultsEl, '');
      });
      if (new URLSearchParams(window.location.search).get('q')) renderUnavailable(resultsEl);
      return;
    }

    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') || '';

    async function runSearch(query) {
      if (!query.trim()) {
        renderEmpty(resultsEl, '');
        countEl.textContent = '';
        return;
      }

      const search = await pagefind.debouncedSearch(query);
      if (search === null) return; // superada por una búsqueda más reciente

      const results = await Promise.all(search.results.map((r) => r.data()));

      if (results.length === 0) {
        renderNoResults(resultsEl, query);
        countEl.textContent = `0 resultados para "${query}"`;
        return;
      }

      const items = results.map((r) => ({
        href: r.url,
        title: r.meta?.title || r.meta?.title_raw || 'Sin título',
        category: normalizeCategory(r.meta?.category) || 'Paddock Daily',
        excerpt: r.excerpt,
      }));

      renderResults(resultsEl, items);
      countEl.textContent = `${items.length} resultado${items.length === 1 ? '' : 's'} para "${query}"`;
    }

    input.addEventListener('input', () => runSearch(input.value));
    runSearch(input.value);
  });
</script>
