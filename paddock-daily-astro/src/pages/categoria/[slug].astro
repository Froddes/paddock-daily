---
import Layout from '../../layouts/Layout.astro';
import CategoryPageBody from '../../components/CategoryPageBody.astro';
import { getCategories, getArticles, getArticleCount, getOpinionColumns } from '../../lib/directus.js';

const PER_PAGE = 13;

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const [articles, articlesTotal, opinionColumns] = await Promise.all([
  getArticles({ categorySlug: category.slug, limit: PER_PAGE, offset: 0 }),
  getArticleCount({ categorySlug: category.slug }),
  getOpinionColumns({ categorySlug: category.slug, limit: 20 }),
]);
const totalPages = Math.max(1, Math.ceil(articlesTotal / PER_PAGE));
const otherCategories = (await getCategories()).filter((c) => c.slug !== category.slug);
---

<Layout title={category.name} headerVariant="full" footerVariant="simple" currentNav={category.slug}>
  <CategoryPageBody
    category={category}
    articles={articles}
    articlesTotal={articlesTotal}
    opinionColumns={opinionColumns}
    otherCategories={otherCategories}
    currentPage={1}
    totalPages={totalPages}
    basePath={`/categoria/${category.slug}`}
  />
</Layout>
