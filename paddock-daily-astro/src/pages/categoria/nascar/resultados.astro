---
// Resultados y clasificación de NASCAR — vía la API pública (no oficial)
// de ESPN (ver src/lib/nascar-api.js). Alcance limitado a la clasificación
// de pilotos: esa API no expone horarios de sesión ni resultados de
// carrera con detalle para NASCAR.
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Resultados NASCAR"
  description="Clasificación de pilotos de la temporada actual, en vivo."
  headerVariant="simple"
  footerVariant="simple"
>
  <div class="article-wrap" data-racecenter-results>
    <div class="breadcrumb">
      <a href="/">Inicio</a> / <a href="/categoria/nascar">NASCAR</a> / Resultados
    </div>

    <section class="article-head">
      <span class="eyebrow-cat">NASCAR · RESULTADOS</span>
      <h1>Clasificación de pilotos</h1>
      <p class="dek">Datos en vivo de la NASCAR Cup Series, vía la API pública (no oficial) de ESPN.</p>
    </section>

    <section class="results-block">
      <div class="results-tablewrap">
        <table class="results-table">
          <thead>
            <tr><th>Pos</th><th>Piloto</th><th>Puntos</th></tr>
          </thead>
          <tbody data-rc-drivers-body>
            <tr><td colspan="3" class="rc-status">Cargando…</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { initRaceCenterResultsPage } from '../../../lib/nascar-api.js';
  initRaceCenterResultsPage(document.querySelector('[data-racecenter-results]'));
</script>
