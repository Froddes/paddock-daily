---
import Layout from '../../layouts/Layout.astro';
import StoryCard from '../../components/StoryCard.astro';
import ThumbPlaceholder from '../../components/ThumbPlaceholder.astro';
import CategoryLogo from '../../components/CategoryLogo.astro';
import { getArticles, getArticleBySlug, formatDate, timeAgo, getAssetUrl } from '../../lib/directus.js';
import { renderMarkdown } from '../../lib/markdown.js';
import AdSlot from '../../components/AdSlot.astro';
import { AD_SLOTS, splitArticleHtml } from '../../lib/ads.js';

export async function getStaticPaths() {
  const articles = await getArticles({ limit: -1 });
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const bodyHtml = renderMarkdown(article.body);
// Anuncio entre párrafos: tras el 3.º (solo si el texto es lo bastante largo).
const [bodyTop, bodyBottom] = splitArticleHtml(bodyHtml, 3);
const coverImageUrl = getAssetUrl(article.featured_image, { width: 1400, height: 700 });
const authorAvatarUrl = getAssetUrl(article.author?.avatar, { width: 60, height: 60 });
const related = article.category
  ? await getArticles({ categorySlug: article.category.slug, excludeSlug: article.slug, limit: 3 })
  : [];
---

<Layout
  title={article.title}
  description={article.dek}
  headerVariant="simple"
  footerVariant="simple"
  image={coverImageUrl}
  type="article"
  article={{
    publishedDate: article.published_date,
    author: article.author?.name,
    section: article.category?.name,
  }}
>
  <div class="article-wrap">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      {article.category && <> / <a href={`/categoria/${article.category.slug}`}>{article.category.name}</a></>}
    </div>

    <section class="article-head">
      <div class="cat-hero-top">
        {article.category && (
          <CategoryLogo slug={article.category.slug} name={article.category.name} size={26} onLight />
        )}
        <span class="eyebrow-cat">{article.category?.name?.toUpperCase()}</span>
      </div>
      <h1>{article.title}</h1>
      <p class="dek">{article.dek}</p>
      <div class="byline">
        <span class="avatar">
          {authorAvatarUrl ? <img src={authorAvatarUrl} alt={article.author?.name} /> : (article.author?.name?.charAt(0) || 'P')}
        </span>
        <div>
          <strong>{article.author?.name}</strong>
          <span>{timeAgo(article.published_date)} · {article.reading_time || 1} min de lectura</span>
        </div>
      </div>
    </section>

    <div class="article-cover">
      {coverImageUrl ? (
        <img src={coverImageUrl} alt={article.title} />
      ) : (
        <ThumbPlaceholder seed={article.slug} />
      )}
    </div>

    <article class="article-body">
      <Fragment set:html={bodyTop} />
      {bodyBottom && <AdSlot slot={AD_SLOTS.articleMid} name="En el artículo (tras el 3.er párrafo)" />}
      <Fragment set:html={bodyBottom} />
    </article>

    <AdSlot slot={AD_SLOTS.articleEnd} minHeight={250} name="Final del artículo" />

    <div class="tag-row">
      {article.category && <a href={`/categoria/${article.category.slug}`}>{article.category.name}</a>}
    </div>
  </div>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap" style="max-width:960px;margin:0 auto;">
        <h2>Sigue leyendo</h2>
        <div class="related-grid">
          {related.map((a) => <StoryCard article={a} />)}
        </div>
      </div>
    </section>
  )}
</Layout>
