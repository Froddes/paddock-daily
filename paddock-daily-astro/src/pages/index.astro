---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import ThumbPlaceholder from '../components/ThumbPlaceholder.astro';
import CategoryLogo from '../components/CategoryLogo.astro';
import AdSlot from '../components/AdSlot.astro';
import { AD_SLOTS } from '../lib/ads.js';
import {
  getArticles,
  getCategories,
  getArticleCountsByCategory,
  getOpinionColumns,
  timeAgo,
  getAssetUrl,
} from '../lib/directus.js';
import { getCategoryCoverUrl } from '../lib/categoryImages.js';
import { sortCategoriesLikeNav } from '../lib/categoryOrder.js';

// Cuántos artículos lleva cada bloque de la portada (además del destacado).
const PORTADA_COUNT = 6;
const ULTIMA_HORA_COUNT = 4;

const latest = await getArticles({ limit: 1 + PORTADA_COUNT + ULTIMA_HORA_COUNT });
const hero = latest.find((a) => a.featured) || latest[0];
const heroImageUrl = hero ? getAssetUrl(hero.featured_image, { width: 1400, height: 900 }) : null;
const heroAvatarUrl = hero ? getAssetUrl(hero.author?.avatar, { width: 60, height: 60 }) : null;
const rest = latest.filter((a) => a.slug !== hero?.slug);
const portada = rest.slice(0, PORTADA_COUNT);
const ultimaHora = rest.slice(PORTADA_COUNT, PORTADA_COUNT + ULTIMA_HORA_COUNT);

const [allCategories, counts, opinionLatest] = await Promise.all([
  getCategories(),
  getArticleCountsByCategory(),
  getOpinionColumns({ limit: 1 }),
]);
// Mismo orden que el menú del navbar (principales primero, luego "Otros").
const categories = sortCategoriesLikeNav(allCategories);
const opinion = opinionLatest[0];

// Categorías con sección de resultados en vivo (páginas /categoria/<slug>/resultados).
const RESULTS_PAGES = [
  { slug: 'f1', title: 'Fórmula 1', text: 'Todo el campeonato al día, sin salir de Paddock Daily.', chips: ['Última carrera', 'Clasificación', 'Pilotos', 'Constructores', 'Calendario'], cta: 'Ver resultados de F1' },
  { slug: 'nascar', title: 'NASCAR', text: 'Cómo va la Cup Series, carrera a carrera.', chips: ['Clasificación de pilotos'], cta: 'Ver clasificación' },
];
const resultsPromo = RESULTS_PAGES.map((r) => {
  const cat = allCategories.find((c) => c.slug === r.slug);
  return cat ? { ...r, name: cat.name, banner: cat.banner } : null;
}).filter(Boolean);
const opinionAvatarUrl = opinion ? getAssetUrl(opinion.author?.avatar, { width: 80, height: 80 }) : null;
---

<Layout title="Inicio" headerVariant="full" footerVariant="full" currentNav="inicio">
  {hero && (
    <section class="hero-section">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <div class="cat-hero-top">
            {hero.category && (
              <CategoryLogo slug={hero.category.slug} name={hero.category.name} size={26} onLight />
            )}
            <span class="eyebrow-cat">{hero.category?.name?.toUpperCase()}</span>
          </div>
          <h1><a href={`/articulo/${hero.slug}`}>{hero.title}</a></h1>
          <p class="hero-dek">{hero.dek}</p>
          <div class="byline">
            <span class="avatar">
              {heroAvatarUrl ? <img src={heroAvatarUrl} alt={hero.author?.name} /> : (hero.author?.name?.charAt(0) || 'P')}
            </span>
            <div>
              <strong>{hero.author?.name}</strong>
              <span>{timeAgo(hero.published_date)} · {hero.reading_time || 1} min de lectura</span>
            </div>
          </div>
        </div>
        <a class="hero-visual" href={`/articulo/${hero.slug}`} aria-label={hero.title}>
          {heroImageUrl ? (
            <img class="hero-img" src={heroImageUrl} alt={hero.title} />
          ) : (
            <ThumbPlaceholder seed={hero.slug} />
          )}
        </a>
      </div>
    </section>
  )}

  {portada.length > 0 && (
    <section class="news-section">
      <div class="wrap">
        <div class="section-head">
          <h2>Portada</h2>
        </div>
        <div class="news-grid">
          {portada.map((article) => <StoryCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  <div class="wrap">
    <AdSlot slot={AD_SLOTS.homeMid} minHeight={120} name="Banner de portada (entre Portada y Última hora)" />
  </div>

  {ultimaHora.length > 0 && (
    <section class="latest-section">
      <div class="wrap latest-layout">
        <div>
          <div class="section-head">
            <h2>Última hora</h2>
          </div>
          <ul class="latest-list">
            {ultimaHora.map((article, i) => {
              const thumbUrl = getAssetUrl(article.featured_image, { width: 200, height: 150 });
              return (
              <li>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <a class="thumb-sm" href={`/articulo/${article.slug}`} aria-label={article.title}>
                  {thumbUrl ? (
                    <img class="thumb-img" src={thumbUrl} alt={article.title} loading="lazy" />
                  ) : (
                    <ThumbPlaceholder seed={article.slug} size="sm" />
                  )}
                </a>
                <div>
                  <h4><a href={`/articulo/${article.slug}`}>{article.title}</a></h4>
                  <span class="meta">{article.category?.name} · {timeAgo(article.published_date)}</span>
                </div>
              </li>
              );
            })}
          </ul>

          {/* Promo de las secciones de resultados en vivo (F1 y NASCAR). */}
          {resultsPromo.length > 0 && (
            <div class="results-promo">
              <div class="section-head">
                <h2>Resultados y clasificaciones</h2>
              </div>
              <div class="results-promo-grid">
                {resultsPromo.map((item) => (
                  <a class="results-promo-card" href={`/categoria/${item.slug}/resultados`}>
                    <div class="rp-top">
                      <CategoryLogo slug={item.slug} name={item.name} size={24} />
                      <span class="rp-live">Datos en vivo</span>
                    </div>
                    <div class="rp-body">
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                      <ul class="rp-chips">
                        {item.chips.map((chip) => <li>{chip}</li>)}
                      </ul>
                    </div>
                    <span class="rp-cta">{item.cta}<span class="rp-arrow" aria-hidden="true">→</span></span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <div class="latest-side">
          <aside class="rail-card home-explore-cats">
            <h4>Explorar por categoría</h4>
            <div class="rail-tags">
              {categories.map((cat) => <a href={`/categoria/${cat.slug}`}>{cat.name}</a>)}
            </div>
          </aside>
          <AdSlot slot={AD_SLOTS.sidebar} sticky minHeight={600} name="Lateral de portada" />
        </div>
      </div>
    </section>
  )}

  <section class="cat-section">
    <div class="wrap">
      <div class="section-head">
        <h2>Todo el paddock</h2>
        <div class="cat-rail-nav">
          <button type="button" class="cat-rail-arrow" data-cat-rail-prev aria-label="Ver categorías anteriores">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="cat-rail-arrow" data-cat-rail-next aria-label="Ver más categorías">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
      <div class="cat-rail" data-cat-rail>
        {categories.map((cat) => (
          <a class="cat-tile" href={`/categoria/${cat.slug}`}>
            <img class="cat-tile-img" src={getCategoryCoverUrl(cat.slug, cat.banner, 700)} alt="" aria-hidden="true" />
            <div class="cat-tile-top">
              <CategoryLogo slug={cat.slug} name={cat.name} size={15} />
              <span>{cat.name}</span>
            </div>
            <small>{counts[cat.id] || 0} artículos</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  {opinion && (
    <section class="opinion-section">
      <div class="wrap">
        <div class="opinion-inner">
          <span class="eyebrow-cat">OPINIÓN</span>
          <p class="opinion-quote">"{opinion.dek}"</p>
          <div class="opinion-byline">
            <span class="avatar">
              {opinionAvatarUrl ? <img src={opinionAvatarUrl} alt={opinion.author?.name} /> : (opinion.author?.name?.charAt(0) || 'P')}
            </span>
            <div><strong>{opinion.author?.name}</strong><span>{opinion.author?.role}</span></div>
          </div>
        </div>
      </div>
    </section>
  )}

</Layout>

<script>
  // Flechas del rail de categorías ("Todo el paddock"): desplazan el
  // contenedor con scroll nativo (igual que el swipe táctil en móvil) y
  // se deshabilitan solas al llegar al principio/final.
  document.querySelectorAll('[data-cat-rail]').forEach((rail) => {
    const section = rail.closest('.cat-section');
    const prevBtn = section?.querySelector('[data-cat-rail-prev]');
    const nextBtn = section?.querySelector('[data-cat-rail-next]');
    if (!prevBtn || !nextBtn) return;

    const scrollByTile = (dir) => {
      // Avanza una "página" entera: tantas categorías como caben a la vista
      // (6 en escritorio). El scroll nativo se detiene en el final, así que
      // si quedan menos de 6 se muestran las restantes + las anteriores
      // necesarias para completar la fila.
      const tile = rail.querySelector('.cat-tile');
      const tileStep = tile ? tile.getBoundingClientRect().width + 16 : rail.clientWidth;
      const visible = Math.max(1, Math.round((rail.clientWidth + 16) / tileStep));
      rail.scrollBy({ left: dir * tileStep * visible, behavior: 'smooth' });
    };

    const updateArrows = () => {
      const max = rail.scrollWidth - rail.clientWidth - 2;
      prevBtn.disabled = rail.scrollLeft <= 0;
      nextBtn.disabled = rail.scrollLeft >= max;
    };

    prevBtn.addEventListener('click', () => scrollByTile(-1));
    nextBtn.addEventListener('click', () => scrollByTile(1));
    rail.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
  });
</script>
