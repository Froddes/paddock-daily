# Copia este archivo a ".env" y ajusta si tu Directus no está en localhost.
PUBLIC_DIRECTUS_URL=http://localhost:8055

# --- Anuncios (AdSense) — todo desactivado por defecto -----------------
# 1) Al solicitar el alta: solo el ID del editor (añade la meta de verificación y /ads.txt).
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# 2) Cuando AdSense apruebe el sitio y el CMP esté publicado:
# PUBLIC_ADS_ENABLED=true
# PUBLIC_ADSENSE_SLOT_ARTICLE_MID=0000000000
# PUBLIC_ADSENSE_SLOT_ARTICLE_END=0000000000
# PUBLIC_ADSENSE_SLOT_SIDEBAR=0000000000
# PUBLIC_ADSENSE_SLOT_HOME_MID=0000000000
